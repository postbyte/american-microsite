---
import Meta from './Meta.astro';
import TopBg from "@/components/ui/TopBg.astro";
import Footer from "@/components/sections/Footer.astro";
import Header from "@/components/sections/Header.astro";
import TrackGa from "@/components/widgets/TrackGa.astro";
interface Props {
	title?: string | undefined;
	description?: string | undefined;
	keywords?: string | undefined;
}

const {
	title,
	description,
	keywords
} = Astro.props;


import "../styles/global.css";
import "aos/dist/aos.css";
import "../styles/aos-custom.css";
import '../styles/article.css';
import '../styles/article-enhancements.css';
---

<html lang="">
  <head>
    <meta charset="UTF-8" />
    <Meta
      title = {title}
      description = {description}
      keywords = {keywords}
    />
    <TrackGa />
    <!--
      Sets the theme before first paint to prevent flicker. Writes BOTH
      data-theme (drives the daisyUI themes) and the legacy .dark class
      (still used by dark: utilities on /blog, /about and /works).
    -->
    <script is:inline>
      (function () {
        var dark = false;
        try {
          dark = localStorage.getItem('dark_mode') === 'true';
        } catch (e) {}
        var root = document.documentElement;
        root.setAttribute('data-theme', dark ? 'acdark' : 'aclight');
        root.classList.toggle('dark', dark);
      })();
    </script>

    <link rel="icon" type="image/x-icon" href="/favicon.png" />
  </head>
  <body class="antialiased bg-base-200 text-base-content max-w-full overflow-x-hidden">
    <TopBg />
    <Header />
    <slot />
    <Footer />
    <script src="../assets/js/main.js"></script>
  </body>
</html>