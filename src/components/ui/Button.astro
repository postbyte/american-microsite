---
/**
 * Reimplemented over daisyUI `btn`. The prop API is unchanged so existing
 * callers (about.astro, Header, BlogSection) keep working untouched.
 */
export interface Props {
	url: string;
	type?: "solid" | "fill" | "disabled";
	className?: string;
	target?: "_blank" | "_self" | "_parent" | "_top";
	size?: "xs" | "sm" | "md" | "lg" | "xl";
}

const {
	url,
	type = "solid",
	className = "",
	target = "_self",
	size = "md",
} = Astro.props;

const sizeClass = {
	xs: "btn-xs",
	sm: "btn-sm",
	md: "",
	lg: "btn-lg",
	xl: "btn-lg h-14 px-9 text-lg",
}[size];

// "fill" = primary action, "solid" = quiet secondary, "disabled" = inert.
const typeClass = {
	fill: "btn-primary border-0",
	solid: "border border-base-300 bg-base-100 text-base-content hover:bg-base-200",
	disabled: "btn-disabled border-0",
}[type];
---

<a
	href={type === "disabled" ? "javascript:void(0)" : url}
	target={type === "disabled" ? undefined : target}
	class={`btn ${sizeClass} ${typeClass} rounded-full font-medium shadow-none ${className}`}
	aria-disabled={type === "disabled" ? "true" : undefined}
	tabindex={type === "disabled" ? "-1" : undefined}
>
	<slot />
</a>
