---
interface Props {
  title: string;
  description: string;
  /** Forthcoming photo. Renders a placeholder figure until supplied. */
  image?: string | null;
  imageAlt?: string;
  /** Degrees to hue-rotate the photo toward the site's cool navy cast. */
  hueShift?: number;
}

const { title, description, image = null, imageAlt = "", hueShift = 0 } = Astro.props;
---

<!--
  Full-width card: copy left, image right, same orientation on every card.
  Stacks to a vertical card below lg. min-h keeps all six exactly the same
  height regardless of how many lines the title wraps to.
-->
<div
  class="card overflow-hidden border border-base-300 shadow-diffuse lg:card-side lg:min-h-[30rem]"
  style="background-image: linear-gradient(115deg, var(--color-base-100) 0%, color-mix(in oklab, var(--color-primary) 6%, var(--color-base-100)) 100%);"
>
  <div class="card-body justify-center gap-5 p-10 sm:p-14 lg:w-1/2 lg:p-16">
    <h3
      class="text-[clamp(1.75rem,2.6vw,2.5rem)] font-semibold leading-[1.1] tracking-[-0.03em]"
    >
      {title}
    </h3>
    <p class="text-lead max-w-md text-base-content/60">{description}</p>
  </div>

  <!--
    self-stretch, not h-full: a percentage height can't resolve against the
    card's auto height, which collapses the figure to its content.
  -->
  <figure
    class="relative grid aspect-[4/3] place-content-center self-stretch bg-base-300/30 sm:aspect-[16/10] lg:aspect-auto lg:w-1/2"
  >
    {
      image ? (
        <img
          src={image}
          alt={imageAlt}
          class="hero-grain absolute inset-0 h-full w-full scale-125 object-cover"
          style={`--hue-shift: ${hueShift}deg`}
          loading="lazy"
        />
      ) : (
        <span class="px-6 text-center text-sm text-base-content/45">
          {imageAlt || "Photo"}
        </span>
      )
    }
  </figure>
</div>
