---
interface Props {
  stats: { value: string; label: string }[];
}

const { stats } = Astro.props;
---

<!-- daisyUI stats. Sits directly on the page tint, no card, no border. -->
<div class="flex justify-center">
  <div
    class="stats stats-vertical sm:stats-horizontal bg-base-100 border border-base-300 shadow-none"
  >
    {
      stats.map((stat) => (
        <div class="stat place-items-center gap-1 px-8 py-6">
          <div class="stat-value text-3xl font-semibold tracking-tight text-primary">
            {stat.value}
          </div>
          <div class="stat-title text-sm font-normal text-base-content/60 text-center whitespace-normal">
            {stat.label}
          </div>
        </div>
      ))
    }
  </div>
</div>
