---
interface Props {
  num: string;
  title: string;
  description: string;
}

const { num, title, description } = Astro.props;
---

<!-- One item of a daisyUI steps list. The numeral lives in data-content. -->
<li class="step step-primary" data-content={num}>
  <div class="pt-4 text-left sm:pt-6">
    <h3 class="text-h3 mb-2">{title}</h3>
    <p class="max-w-sm text-base leading-relaxed text-base-content/65">
      {description}
    </p>
  </div>
</li>
