---
interface Props {
  value: string;
  description: string;
}

const { value, description } = Astro.props;
---

<div class="stat gap-2 px-0 py-2">
  <div
    class="stat-value text-[clamp(2.5rem,5vw,3.75rem)] font-semibold leading-none tracking-[-0.03em] text-primary"
  >
    {value}
  </div>
  <div
    class="stat-desc text-base leading-relaxed text-base-content/65 whitespace-normal"
  >
    {description}
  </div>
</div>
