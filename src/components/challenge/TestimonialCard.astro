---
interface Props {
  quote: string;
  attribution: string;
  /** Forthcoming athlete photo. Renders a placeholder figure until supplied. */
  image?: string | null;
  imageAlt?: string;
}

const { quote, attribution, image = null, imageAlt = "" } = Astro.props;
---

<div class="card h-full overflow-hidden bg-base-100 border border-base-300 shadow-diffuse">
  <figure class="aspect-[4/3] w-full bg-base-300/60">
    {
      image ? (
        <img
          src={image}
          alt={imageAlt}
          class="h-full w-full object-cover"
          loading="lazy"
        />
      ) : (
        <span class="text-sm text-base-content/45">Athlete photo</span>
      )
    }
  </figure>
  <div class="card-body gap-4 p-7">
    <p class="text-base leading-relaxed text-base-content">{quote}</p>
    <p class="mt-auto text-sm font-medium text-base-content/60">
      {attribution}
    </p>
  </div>
</div>
