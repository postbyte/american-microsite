---
import AnimatedText from "@/components/ui/AnimatedText.astro";

interface Props {
  /** Optional: existing callers (Explore, FeaturedWork) may pass undefined. */
  title?: string;
  description?: string;
  /** Small uppercase label above the heading. */
  eyebrow?: string;
  /** "dark" forces light text when placed on the navy panel. */
  tone?: "light" | "dark";
  /** Bevel centres section intros; content below stays left-aligned. */
  align?: "center" | "left";
  class?: string;
}

const {
  title = "",
  description,
  eyebrow,
  tone = "light",
  align = "center",
  class: className = "",
} = Astro.props;

const isDark = tone === "dark";
const isCentered = align === "center";
---

<div
  class:list={[
    "relative z-20 w-full",
    isCentered ? "mx-auto max-w-3xl text-center" : "max-w-2xl text-left",
    className,
  ]}
>
  {
    eyebrow && (
      <p class:list={["text-eyebrow mb-5", isDark ? "text-accent-content/70" : "text-accent-text"]}>
        {eyebrow}
      </p>
    )
  }
  <h2 class:list={["text-h2", isDark && "!text-primary-content"]}>
    <AnimatedText delay={0.2} stagger={0.08} content={title} />
  </h2>
  {
    description && (
      <div
        class:list={[
          "text-lead mt-6",
          isDark ? "text-primary-content/70" : "text-base-content/65",
          isCentered && "mx-auto",
        ]}
      >
        <AnimatedText delay={0.6} stagger={0.03} content={description} />
      </div>
    )
  }
</div>
