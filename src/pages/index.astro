---
import { ChevronLeft, ChevronRight } from "@lucide/astro";
import Layout from "@/layouts/Layout.astro";
import Button from "@/components/ui/Button.astro";
import AnimatedText from "@/components/ui/AnimatedText.astro";
import SectionHeader from "@/components/elements/SectionHeader.astro";

import ProofStrip from "@/components/challenge/ProofStrip.astro";
import ChatCard from "@/components/challenge/ChatCard.astro";
import JobCard from "@/components/challenge/JobCard.astro";
import StepCard from "@/components/challenge/StepCard.astro";
import Panel from "@/components/challenge/Panel.astro";
import Leaderboard from "@/components/challenge/Leaderboard.astro";
import StatFigure from "@/components/challenge/StatFigure.astro";
import FaqAccordion from "@/components/challenge/FaqAccordion.astro";

import challenge from "@/collections/challenge.json";

const {
  proofStats,
  dayCards,
  sixJobs,
  howItWorks,
  leaderboard,
  oldWay,
  outcomeStats,
  testimonials,
  faq,
} = challenge;

const aos = {
  "data-aos": "fade-up-sm",
  "data-aos-delay": "100",
  "data-aos-duration": "600",
  "data-aos-once": "true",
};
---

<Layout
  title="The American Challenge — 30 Days, Built Like Training | Sam"
  description="Join student-athletes across the American Conference in a 30-day challenge for the stuff that's actually heavy off the field. Free, private, 2 minutes a day."
  keywords="American Conference student-athlete challenge, Sam, student-athlete mental performance, The American Challenge"
>
  <!-- 1. Hero — centred, oversized, on the animated mesh-gradient page wash -->
  <section class="site-container relative z-20 pt-16 pb-20 text-center md:pt-24">
    <p class="text-eyebrow text-accent-text">The American Challenge</p>

    <h1 class="mx-auto mt-7 max-w-4xl">
      <AnimatedText
        content="Your best semester yet"
        delay={0.1}
        duration={0.5}
        stagger={0.08}
        class="text-display"
      />
    </h1>

    <div class="mx-auto mt-7 max-w-xl">
      <AnimatedText
        content="Mental Performance Coaching for on and off the field."
        delay={0.3}
        duration={0.5}
        stagger={0.015}
        class="text-lead text-base-content/65"
      />
    </div>

    <div
      class="mt-10 flex flex-col items-center gap-4"
      data-aos="fade-up-sm"
      data-aos-delay="800"
      data-aos-duration="500"
      data-aos-once="true"
    >
      <Button url="#final" type="fill" size="lg">Sign Your School Up</Button>
      <p class="text-sm text-base-content/55">
        This is more than sports, this is about you.
      </p>
    </div>
  </section>

  <!--
    SVG grain filter for the hero band. fractalNoise is desaturated, boosted
    hard, then blended over the photo — heavy enough to read as film grain
    rather than a texture overlay.
  -->
  <svg aria-hidden="true" focusable="false" class="pointer-events-none absolute h-0 w-0">
    <filter id="heroGrain" x="0" y="0" width="100%" height="100%">
      <feTurbulence
        type="fractalNoise"
        baseFrequency="0.9"
        numOctaves="4"
        stitchTiles="stitch"
        result="noise"
      />
      <feColorMatrix in="noise" type="saturate" values="0" result="mono" />
      <feComponentTransfer in="mono" result="grain">
        <feFuncA type="linear" slope="0.85" intercept="-0.18" />
      </feComponentTransfer>
      <feBlend in="SourceGraphic" in2="grain" mode="overlay" />
    </filter>
  </svg>

  <!-- Full-bleed photography band. Bevel puts imagery edge-to-edge, not in a card. -->
  <div class="px-3 sm:px-4 lg:px-6" {...aos}>
    <div
      class="relative mx-auto flex min-h-[32rem] w-full max-w-[1600px] items-center justify-center overflow-hidden rounded-[2rem] bg-base-300/60 shadow-diffuse lg:min-h-0 lg:aspect-[2.6/1]"
    >
      <!-- scale + object-cover crops tight into the 5000x5000 source -->
      <img
        src="/assets/home/cover.jpg"
        alt="Student-athlete mid-effort, American Conference campus"
        class="hero-grain absolute inset-0 h-full w-full scale-[1.35] object-cover object-[38%_62%]"
        width="5000"
        height="5000"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />

      <!--
        Carousel overlaid on the photography, using daisyUI's full-bleed
        pattern: carousel-center with space-x/p rather than gap, and items
        narrower than the track so neighbouring slides peek in at both edges.
        Scroll-snaps natively — daisyUI's carousel is CSS-only.
      -->
      <div class="absolute inset-0 flex items-center gap-6 px-6 sm:px-10">
        <div class="hidden w-1/3 shrink-0 md:block">
          <SectionHeader
            title="This is what a month of locking in looks like."
            align="left"
            class="!max-w-none [&_h2]:!text-white"
          />
        </div>
        <div class="carousel-fade min-w-0 flex-1 overflow-hidden">
          <div
            class="carousel carousel-center w-full space-x-4 p-4 sm:space-x-6 sm:p-6"
            aria-label="What a day looks like"
          >
            {
              dayCards.map((card, i) => (
                <div
                  id={`day-${i + 1}`}
                  class="carousel-item w-[58%] sm:w-[34%] lg:w-[30%]"
                >
                  <ChatCard quote={card.quote} reply={card.reply} variant="glass" />
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>

  </div>

  <!-- 2. Proof Strip -->
  <div class="site-container pt-16 sm:pt-20" {...aos}>
    <ProofStrip stats={proofStats} />
  </div>

  <!-- 3. This is what a day looks like 
  <section class="site-container section-y" {...aos}>
    <SectionHeader title="This is what a day looks like." />
    <div class="mt-16 grid gap-6 md:grid-cols-3">
      {dayCards.map((card) => <ChatCard quote={card.quote} reply={card.reply} />)}
    </div>
  </section>-->

  <!-- 4. Six things actually worth training for -->
  <section id="challenges" class="site-container section-y" {...aos}>
    <SectionHeader
      title="Six things actually worth training for."
      description="Every challenge maps to one of these. None of them are about being fixed."
    />
    <div class="mt-16 flex flex-col gap-6">
      {
        sixJobs.map((job) => (
          <JobCard
            title={job.title}
            description={job.description}
            image={job.image}
            imageAlt={job.imageAlt}
          />
        ))
      }
    </div>
  </section>

  <!-- 5. How it works -->
  <section id="how" class="site-container pb-24" {...aos}>
    <SectionHeader title="How it works." />
    <ul class="steps steps-vertical mt-14 w-full lg:steps-horizontal">
      {
        howItWorks.map((step) => (
          <StepCard
            num={step.num}
            title={step.title}
            description={step.description}
          />
        ))
      }
    </ul>
  </section>

  <!-- 6. Your school is in a race — navy moment #1 of 2 -->
  <Panel id="leaderboard" tone="navy">
    <div class="grid items-center gap-14 p-10 sm:p-14 md:grid-cols-2 lg:gap-20">
      <div {...aos}>
        <h2 class="text-h2 !text-primary-content">Your school is in a race.</h2>
        <p class="text-lead mt-6 text-primary-content/75">
          Every check-in is a point for your school. The school that
          participates the most wins $1,500 for its SAAC. You don't need your
          whole team to sign up to start climbing — but it helps. Go recruit.
        </p>
        <a
          href="#leaderboard"
          class="btn btn-accent mt-9 rounded-full border-0 font-medium shadow-none"
        >
          Check the Leaderboard
        </a>
      </div>
      <div {...aos}>
        <Leaderboard rows={leaderboard} />
      </div>
    </div>
  </Panel>

  <!-- 7. Built to actually listen -->
  <section class="site-container section-y" {...aos}>
    <SectionHeader
      title="Built to actually listen."
      description="Most advice hands you a checklist before it knows what's wrong. Sam asks what's actually going on first and what's actually eating at you. That where the real conversations start. That's not a script. That's what a good conversation with someone who's paying attention sounds like."
    />
    <div class="mt-16 grid items-stretch gap-6 md:grid-cols-5">
      <div class="card border border-base-300 bg-base-100 shadow-diffuse md:col-span-2">
        <div class="card-body p-8">
          <p class="text-eyebrow mb-6 text-base-content/45">The old way</p>
          <ul class="flex flex-col gap-3">
            {
              oldWay.map((line) => (
                <li class="text-base text-base-content/50">{line}</li>
              ))
            }
          </ul>
        </div>
      </div>
      <div class="card bg-base-300/50 shadow-diffuse md:col-span-3">
        <div class="card-body justify-center p-8 sm:p-12">
          <p class="text-eyebrow mb-6 text-accent-text">Sam</p>
          <p class="text-h2 !text-[clamp(1.75rem,3vw,2.5rem)]">
            What's actually eating at you today?
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 8. It's already working -->
  <section class="site-container pb-24" {...aos}>
    <SectionHeader title="Sam's already working for student-athletes." />
    <div class="mt-16 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      {
        outcomeStats.map((stat) => (
          <StatFigure value={stat.value} description={stat.description} />
        ))
      }
    </div>
  </section>

  <!-- 9. From athletes who've used it -->
  <section class="site-container pb-24" {...aos}>
    <SectionHeader title="From athletes who've used it." />
    <div class="mt-16">
      <div class="carousel-fade overflow-hidden">
        <div
          id="testimonial-carousel"
          class="carousel carousel-center w-full gap-6 px-1 pb-4"
          aria-label="Testimonials from student-athletes"
        >
          {
            testimonials.map((item, i) => (
              <div
                id={`testimonial-${i + 1}`}
                class="carousel-item w-[88%] sm:w-[72%] lg:w-[56%]"
              >
                <div class="h-full w-full p-10 drop-shadow-md sm:p-14">
                  <span
                    aria-hidden="true"
                    class="font-serif text-[4.5rem] leading-none text-accent-text/70"
                  >
                    &ldquo;
                  </span>
                  <p class="text-h2 mt-2 !text-[clamp(1.5rem,2.6vw,2.25rem)] !leading-[1.3]">
                    {item.quote}
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
      <div class="mt-5 flex justify-center gap-2">
        <button
          type="button"
          data-carousel-prev="testimonial-carousel"
          class="btn btn-sm btn-circle border border-base-300 bg-base-100 shadow-none hover:bg-base-200"
          aria-label="Previous testimonial"
        >
          <ChevronLeft class="size-4" />
        </button>
        <button
          type="button"
          data-carousel-next="testimonial-carousel"
          class="btn btn-sm btn-circle border border-base-300 bg-base-100 shadow-none hover:bg-base-200"
          aria-label="Next testimonial"
        >
          <ChevronRight class="size-4" />
        </button>
      </div>
    </div>
  </section>

  <script>
    // CSS-only scroll-snap carousel — these buttons just nudge native
    // scroll by one viewport-worth of the track; no slide-index state to
    // keep in sync since the carousel itself carries none.
    for (const btn of document.querySelectorAll<HTMLButtonElement>(
      "[data-carousel-prev], [data-carousel-next]",
    )) {
      const id = btn.dataset.carouselPrev ?? btn.dataset.carouselNext;
      const track = id ? document.getElementById(id) : null;
      if (!track) continue;
      const dir = btn.hasAttribute("data-carousel-prev") ? -1 : 1;
      btn.addEventListener("click", () => {
        track.scrollBy({ left: dir * track.clientWidth * 0.9, behavior: "smooth" });
      });
    }
  </script>

  <!-- 10. Private by design — the quiet pause, deliberately NOT dark -->
  <Panel id="privacy" class="relative">
    <img
      src="/assets/home/locker.jpg"
      alt=""
      aria-hidden="true"
      class="hero-grain absolute inset-0 h-full w-full scale-125 object-cover"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-base-100/45" />
    <div
      class="relative z-10 mx-auto max-w-2xl px-8 py-24 text-center sm:py-28"
      {...aos}
    >
      <h2 class="text-h2">Private by design.</h2>
      <p class="text-lead mt-7 text-base-content/65">
        What you tell Sam stays with Sam, unless you choose to share it. No
        coach sees your check-ins. No default reporting to your athletic
        department. Disclosure happens when you decide it should — not before.
        Sam is not therapy, and it always says so plainly.
      </p>
    </div>
  </Panel>

  <!-- 11. FAQ -->
  <section id="faq" class="section-y mx-auto max-w-3xl px-4" {...aos}>
    <SectionHeader title="Questions." />
    <div class="mt-14">
      <FaqAccordion items={faq} />
    </div>
  </section>

  <!-- 12. Final CTA — navy moment #2 of 2 -->
  <Panel id="final" tone="navy">
    <div class="mx-auto max-w-2xl px-8 py-24 text-center sm:py-28" {...aos}>
      <h2 class="text-h2 !text-primary-content">
        30 days. Whenever you're ready.
      </h2>
      <p class="text-lead mt-6 text-primary-content/75">
        Early access opens August 18. The challenge runs September 8 – October 8.
      </p>
      <a
        href="#final"
        class="btn btn-accent btn-lg mt-10 rounded-full border-0 font-medium shadow-none"
      >
        Sign Your School Up
      </a>
    </div>
  </Panel>
</Layout>
